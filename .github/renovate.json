{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended",  "customManagers:biomeVersions"],
  "baseBranchPatterns": [
    "develop"
  ],
  "ignoreDeps": ["eslint"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    }
  ]
}
